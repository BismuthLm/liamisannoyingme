{
  "name": "liamisannoying-terminal",
  "version": "1.0.0",
  "description": "MS-DOS style terminal application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "terminal",
    "msdos",
    "ascii",
    "retro"
  ],
  "author": "Liam Mitchell",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.8.4",
    "electron-builder": "^26.6.0",
    "electron-updater": "^6.7.3"
  },
  "build": {
    "appId": "com.liamisannoying.terminal",
    "productName": "LIAMISANNOYING Terminal",
    "publish": {
      "provider": "github",
      "owner": "BismuthLm",
      "repo": "liamisannoyingme"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "liamisannoying-terminal-standalone.html",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
